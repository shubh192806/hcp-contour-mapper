# The deployed backend's URL, no trailing slash.
# Leave this file unused for local dev — Vite's proxy (see vite.config.js)
# already forwards /api/* to http://localhost:8000 automatically.
#
# For a production deploy (e.g. on Vercel/Netlify), copy this to .env and
# fill in your actual Render backend URL, or set the same variable in your
# hosting provider's dashboard — do not commit a real .env file.
VITE_API_BASE_URL=https://your-backend-name.onrender.com
